        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"Mike\",\r\n    \"lastname\" : \"Jones\",\r\n    \"totalprice\" : 99,\r\n    \"depositpaid\" : false,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2026-06-29\",\r\n        \"checkout\" : \"2026-07-03\"\r\n    },\r\n    \"additionalneeds\" : \"Ocean View\"\r\n}",
